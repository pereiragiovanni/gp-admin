<h1 class="font-bold text-2xl text-gray-900"><%= t(".title") %></h1>

<%= form_with url: passwords_path, class: "contents" do |form| %>
  <div class="my-5">
    <%= render RubyUI::Input.new(type: :email, name: "email_address", id: "email_address", required: true, autofocus: true, autocomplete: "username", placeholder: t(".email_placeholder"), value: params[:email_address]) %>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to new_session_path,
          class: "whitespace-nowrap inline-flex items-center justify-center rounded-md font-medium transition-colors px-4 py-2 h-9 text-sm bg-secondary text-secondary-foreground hover:bg-opacity-80" do %>
      <%= t(".back") %>
    <% end %>
    <%= render(RubyUI::Button.new(type: :submit)) { t(".submit") } %>
  </div>
<% end %>
